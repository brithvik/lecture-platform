# Layer 1: the cluster only.
# When moving to the cloud, this is the only folder that changes (kind becomes AKS, OKE, etc.).
resource "kind_cluster" "this" {
  name           = var.cluster_name
  wait_for_ready = true

  kind_config {
    kind        = "Cluster"
    api_version = "kind.x-k8s.io/v1alpha4"

    node {
      role = "control-plane"
    }
  }
}
